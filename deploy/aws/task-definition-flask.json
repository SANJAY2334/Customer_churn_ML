{
  "family": "telecom-churn-flask-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/telecom-churn-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::123456789012:role/telecom-churn-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "flask-api",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/telecom-churn-api:v1.0.0",
      "essential": true,
      "command": [
        "gunicorn",
        "--workers=4",
        "--threads=2",
        "--worker-class=gthread",
        "--bind=0.0.0.0:5000",
        "--access-logfile=-",
        "--error-logfile=-",
        "flask_app:app"
      ],
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "ENVIRONMENT", "value": "production"},
        {"name": "FLASK_ENV", "value": "production"},
        {"name": "APP_ENV", "value": "production"},
        {"name": "RATE_LIMIT_STORAGE", "value": "shared"},
        {"name": "RATE_LIMIT_DB_PATH", "value": "/tmp/telecom_rate_limits.sqlite3"},
        {"name": "RATE_LIMIT_PER_MINUTE", "value": "60"},
        {"name": "ACTIVE_MODEL_KEY", "value": "xgboost"},
        {"name": "CHURN_DECISION_THRESHOLD", "value": "0.3236"},
        {"name": "MAX_CONTENT_LENGTH", "value": "16777216"}
      ],
      "secrets": [
        {
          "name": "CHURN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:telecom/churn/prod:API_KEY::"
        },
        {
          "name": "API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:telecom/churn/prod:API_KEY::"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5000/api/live || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/telecom-churn-flask-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "readonlyRootFilesystem": true,
      "mountPoints": [],
      "volumesFrom": []
    }
  ]
}
