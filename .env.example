# ==============================================================================
# TELECOM CUSTOMER CHURN SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with secret values.
# DO NOT commit the populated '.env' file to source control.

# Application Environment (development, testing, production)
FLASK_ENV=production
APP_ENV=production

# Server Network Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
STREAMLIT_PORT=8501

# API Authentication & Authorization
# Enable API key authentication in production:
API_AUTH_ENABLED=true
# Set a strong, randomly-generated secret token for API access:
CHURN_API_KEY=YOUR_SECURE_RANDOMLY_GENERATED_API_KEY_HERE

# Model Selection & Integrity
# Active production model: auto (defaults to XGBoost), XGBoost, Logistic Regression, Random Forest
CHURN_ACTIVE_MODEL=auto
# Expected cryptographic SHA-256 hash of active artifact (Models/churn_model.pkl)
CHURN_ARTIFACT_SHA256=a9f0053a700de50daab7c453f4bd690d7cd09ad0c10927240234a4895d791363

# Operational Risk Categorization Thresholds
CHURN_RISK_LOW_THRESH=0.30
CHURN_RISK_MED_THRESH=0.60

# Rate Limiting & Networking
RATE_LIMIT_PER_MINUTE=60
# Comma-separated list of allowed origins, or specific production domain:
CORS_ALLOWED_ORIGINS=https://churn.telecom.company.com,https://api.telecom.company.com

# Logging & Monitoring
LOG_LEVEL=INFO
